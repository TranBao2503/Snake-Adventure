# Storage: 'memory' (default, data is lost on restart) or 'mysql' (uses DB_* below).
STORAGE_DRIVER=memory
HOST=127.0.0.1
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_TTL_SECONDS=604800
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=900

# MySQL 8.0.19+ (only read when STORAGE_DRIVER=mysql). Create the tables first with database/schema.sql.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=snake_adventure
DB_POOL_SIZE=10
